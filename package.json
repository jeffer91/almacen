{
  "name": "nicole-encajes",
  "version": "2.1.0",
  "description": "Catálogo familiar Nicole Encajes para Edgar, Gloria y Jefferson, con Supabase y Electron.",
  "main": "app/main/desktop.js",
  "author": "Jefferson Villarreal",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "test": "node --test",
    "release:check": "npm test",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis --x64",
    "verify:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-build.ps1",
    "release:win": "npm run release:check && npm run build:win && npm run verify:win"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "41.2.1",
    "electron-builder": "26.0.12"
  }
}
